`/* #undef DNNL_EXPERIMENTAL_LOGGING */`
`/* #undef DNNL_EXPERIMENTAL_SYCL_KERNEL_COMPILER */`
`#define BUILD_PRIMITIVE_ALL 1`
`#define BUILD_PRIMITIVE_CPU_ISA_ALL 0`
`#define BUILD_AVX2 1`
`#define BUILD_PRIMITIVE_GPU_ISA_ALL 0`
`#define BUILD_XELP 1`
`#define BUILD_GEMM_KERNELS_ALL 0`
`#define BUILD_GEMM_AVX2 1`

